#include <../boards/shields/kyria/boards/nice_nano.overlay>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>


#define DEFAULT 0
#define SWAP 1
#define NUMPAD 2
#define SYMBOLS 3
#define WINDOWS 4
#define RGB 5
#define BLUETOOTH 6

&left_encoder {
	resolution = <2>;
};

&right_encoder {
	resolution = <4>;
};

&mt {
	flavor = "tap-preferred";
};

&lt {
	flavor = "hold-preferred";
	tapping-term-ms = <200>;
};

/ {
	behaviors {
		ltq: layer_tap_quick {
			compatible = "zmk,behavior-hold-tap";
			label = "LAYER_TAP_QUICK";
			#binding-cells = <2>;
			flavor = "tap-preferred";
			tapping-term-ms = <200>;
			quick-tap-ms = <125>;
			bindings = <&mo>, <&kp>;
		};
	};

	keymap {
		compatible = "zmk,keymap";

		default_layer {
			display-name = "Default Layer";
// ---------------------------------------------------------------------------------------------------------------------------------
// |  ESC  |  Q  |  W  |  E   |RGB/R |  T   |                                          |  Y   |  U    |  I    |  O   |   P   | BSPC |
// |TAB/CTL|  A  |  S  |  D   |  F   |  G   |                                          |  H   |  J    |  K    |  L   |   ;   |   [  |
// | SHIFT |  Z  |  X  |  C   |  V   |  B   | L CTRL  |  SPACE  |  |   RET   | WINDOWS |  N   |  M    |  ,    |  .   |   _   | DEL  |
//                     | MUTE | ALT  | GUI  |  SWAP   |  SPACE  |  |   RET   | SYMBOLS | GUI  | NUMPAD| PLAY  |
			bindings = <
	&kp ESC			&kp Q		&kp W		&kp E		&ltq RGB R		&kp T                                         												&kp Y 				&kp U		&kp I		&kp O		&kp P		&kp BSPC
	&mt LCTRL TAB	&kp A       &kp S       &kp D       &kp F 			&kp G                                               								&kp H 				&kp J		&kp K		&kp L		&kp SEMI 	&kp LBKT 
	&kp LSHFT 		&kp Z 		&kp X       &kp C       &kp V       	&kp B 			&kp LCTRL	&kp SPACE   		&kp RET 		&to WINDOWS		&kp N 				&kp M		&kp COMMA 	&kp DOT 	&kp UNDER 	&kp DEL
	                						&kp C_MUTE  &kp LALT    	&kp LGUI  	&mo SWAP 	&kp SPACE     		&kp RET			&mo SYMBOLS 	&kp LGUI 			&mo NUMPAD 	&kp C_PP 
			>;

			sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_VOL_DN C_VOL_UP>;
		};
                        
		swap_layer {
			display-name = "Swap Layer";
// ---------------------------------------------------------------------------------------------------------------------------------
// | BSPC  |  1  |  2  |  3   |  4   |  5   |                                          |  6   |  7    |  8    |  9   |   0   | ESC  |
// |  TAB  |     |     |      |      |      |                                          |      |  UP   |       |      |       |TAB/CTL|
// | SHIFT |     |     |      |      |      |         |         |  | CAPS_W  |         | LEFT | DOWN  | RIGHT |      |       | SHIFT|
//                     | MUTE | ALT  |SYMBOL| SPACE   | TRANS   |  | TRANS   |  RET    |NUMPAD| PREV  | MUTE  |
			bindings = <
	&kp BSPC		&kp N1		&kp N2		&kp N3		&kp N4		&kp N5                                        										&kp N6			&kp N7			&kp N8		&kp N9		&kp N0		&kp ESC
	&kp TAB 	    &none  	    &none 		&none 		&none 		&none                                            									&none 			&kp UP  		&none     	&none   	&none 		&mt LCTRL TAB
	&kp RSHFT 		&none 	    &none		&none       &none 		&none		    &none		    &none				&caps_word		&none			&kp LEFT 	    &kp DOWN  		&kp RIGHT 	&none 	    &none 	    &kp LSHFT
	                     					&mo C_MUTE 	&kp LALT 	&mo SYMBOLS 	&kp SPACE 		&trans         		&trans 			&kp RET			&mo NUMPAD		&kp C_PREV 		&kp C_MUTE
			>;

			sensor-bindings = <&inc_dec_kp LEFT RIGHT &inc_dec_kp LEFT RIGHT>;
		};

		numpad_layer {
			display-name = "Numpad Layer";
// ---------------------------------------------------------------------------------------------------------------------------------
// |  F1   | F2  | F3  | F4   | F5   | F6   |                                          |  7   |  8    |  9    |  *   |  F7   |  F8  |
// | INSERT|PG_DN|LEFT | DOWN |RIGHT |  [   |                                          |  4   |  5    |  6    |  -   |  F9   | F10  |
// | TRANS |TRANS|TRANS|TRANS |TRANS |  (   | TRANS   | TRANS   |  | TRANS   | TRANS  |  1   |  2    |  3    |  +   |  F11  | F12  |
//                     | TRANS|TRANS |TRANS | TRANS   | TRANS   |  | TRANS   | TRANS  |  0   | TRANS | TRANS |
			bindings = <
	&kp F1		&kp F2			&kp F3			&kp F4		&kp F5		&kp F6                                  							&kp N7			&kp N8		&kp N9 		&kp KP_MULTIPLY		&kp F7 		&kp F8
	&kp INSERT	&kp PG_DN		&kp LEFT 		&kp DOWN 	&kp RIGHT 	&kp LBKT                                  							&kp N4 			&kp N5  	&kp N6 		&kp KP_MINUS		&kp F9 		&kp F10
	&trans     	&trans 			&trans 			&trans 		&trans 		&kp LPAR		&trans		&trans   		&trans		&trans 		&kp N1 			&kp N2  	&kp N3 		&kp KP_PLUS 		&kp F11  	&kp F12
	                         					&trans 			&trans 	&trans 			&trans 		&trans         	&trans 		&trans 		&kp N0 			&trans 		&trans
			>;
		};

		symbol_layer {
			display-name = "Symbols Layer";
// ---------------------------------------------------------------------------------------------------------------------------------
// | ESC   |  !  |  @  |  #   |  $   |  %   |                                          |  ^   |  &    |  *    |  (   |   )   | BSPC |
// | TRANS |TRANS|TRANS|  F   |TRANS |  P   |                                          |  <   |  ]    |  '    |  \   |   -   |  |   |
// | TRANS |TRANS|TRANS|TRANS |TRANS |  P   | TRANS   | TRANS   |  | TRANS   | TRANS  |  /   |  +    |  <    |  >   |  =    |  ~   |
//                     |TRANS |TRANS |TRANS | TRANS   | TRANS   |  | TRANS   | TRANS  |TRANS | TRANS | TRANS |
			bindings = <
	&kp ESC		&kp EXCL		&kp AT		&kp HASH		&kp DOLLAR		&kp PRCNT                                 							&kp CARET		&kp AMPS	&kp STAR		&kp LPAR		&kp RPAR		&kp BSPC
	&trans		&trans			&trans		&kp F 			&trans 			&kp P                      											    &kp LT		&kp RBRC	&kp SQT			&kp BSLH		&kp MINUS		&kp PIPE
	&trans		&trans			&trans		&trans			&trans			&kp P			&trans		&trans				&trans		&trans		&kp SLASH		&kp KP_PLUS	&kp LT		&kp GT	&kp EQUAL		&kp TILDE
	                          				&trans			&trans			&trans			&trans		&trans				&trans		&trans		&trans			&trans		&trans
			>;

		};

windows_layer {
		display-name = "Windows Layer";
// ---------------------------------------------------------------------------------------------------------------------------------
// |  ESC  |  Q  |  W  |  E   |RGB/R |  T   |                                          |  Y   |  U    |  I    |  O   |   P   | BSPC |
// |TAB/CTL|  A  |  S  |  D   |  F   |  G   |                                          |  H   |  J    |  K    |  L   |   ;   |   [  |
// | SHIFT |  Z  |  X  |  C   |  V   |  B   | L GUI   |  SPACE  |  |   RET   | DEFAULT |  N   |  M    |  ,    |  .   |   _   | DEL  |
//                     | MUTE | GUI  | CTRL |  SWAP   |  SPACE  |  |   RET   | SYMBOLS | CTRL | NUMPAD| PLAY  |
		bindings = <
	&kp ESC			&kp Q		&kp W		&kp E		&ltq RGB R		&kp T                                         												&kp Y 				&kp U		&kp I		&kp O		&kp P		&kp BSPC
	&mt LCTRL TAB	&kp A       &kp S       &kp D       &kp F 			&kp G                                               								&kp H 				&kp J		&kp K		&kp L		&kp SEMI 	&kp LBKT 
	&kp LSHFT 		&kp Z 		&kp X       &kp C       &kp V       	&kp B 			&kp LGUI	&kp SPACE   		&kp RET 		&to DEFAULT		&kp N 				&kp M		&kp COMMA 	&kp DOT 	&kp UNDER 	&kp DEL
	                						&kp C_MUTE  &kp LGUI    	&kp LCTRL  	&mo SWAP 	&kp SPACE     		&kp RET			&mo SYMBOLS 	&kp LCTRL 			&mo NUMPAD 	&kp C_PP 
			>;

		};

		rgb_layer {
			display-name = "RGB Layer";
// ---------------------------------------------------------------------------------------------------------------------------------
// | TRANS |TRANS|TRANS|TRANS |TRANS |TRANS |                                          |RGB_ON|RGB_OFF|TRANS  |TRANS |TRANS  |TRANS |
// | TRANS |TRANS|TRANS|TRANS |TRANS |TRANS |                                          |RGB_TOG|RGB_HUI|RGB_SAI|RGB_BRI|RGB_SPI|RGB_EFF|
// | TRANS |TRANS|TRANS|TRANS |TRANS |TRANS | TRANS   | TRANS   |  | TRANS   | TRANS  |TRANS |RGB_HUD|RGB_SAD|RGB_BRD|RGB_SPD|RGB_EFR|
//                     |TRANS |TRANS |TRANS | TRANS   | TRANS   |  | TRANS   | TRANS  |TRANS | TRANS | TRANS |
			bindings = <
	&trans &trans &trans &trans &trans &trans                                &rgb_ug RGB_ON &rgb_ug RGB_OFF &out OUT_BLE &out OUT_USB &out OUT_TOG &bt BT_CLR
	&trans &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4    &rgb_ug RGB_TOG &rgb_ug RGB_HUI &rgb_ug RGB_SAI &rgb_ug RGB_BRI &rgb_ug RGB_SPI &rgb_ug RGB_EFF
	&trans &trans &trans &trans &trans &trans &trans &trans    &trans &trans &trans          &rgb_ug RGB_HUD &rgb_ug RGB_SAD &rgb_ug RGB_BRD &rgb_ug RGB_SPD &rgb_ug RGB_EFR
	                     &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans
			>;

		};

		bluetooth_layer {
			display-name = "Bluetooth Layer";
// ---------------------------------------------------------------------------------------------------------------------------------
// |BT_NXT |BT_0 |BT_1 |BT_2  |BT_3  |BT_4  |                                          |TRANS |TRANS  |TRANS  |TRANS |TRANS  |TRANS |
// |BT_PRV |TRANS|TRANS|TRANS |TRANS |TRANS |                                          |TRANS |TRANS  |TRANS  |TRANS |TRANS  |TRANS |
// | TRANS |TRANS|TRANS|OUT_BLE|OUT_USB|OUT_TOG| TRANS | TRANS   |  | TRANS   | TRANS  |TRANS |TRANS  |TRANS  |TRANS |TRANS  |TRANS |
//                     |BT_CLR|TRANS |TRANS | TRANS   | TRANS   |  | TRANS   | TRANS  |TRANS | TRANS | TRANS |
			bindings = <
	&bt BT_NXT &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4                    &trans &trans &trans &trans &trans &trans
	&bt BT_PRV &trans &trans &trans &trans &trans                                                  &trans &trans &trans &trans &trans &trans
	&trans     &trans &trans &out OUT_BLE &out OUT_USB &out OUT_TOG &trans &trans    &trans &trans &trans &trans &trans &trans &trans &trans
	                         &bt BT_CLR &trans &trans &trans &trans                  &trans &trans &trans &trans &trans
			>;

		};

	};
};
